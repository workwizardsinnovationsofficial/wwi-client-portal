rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isWWIStaff() {
      return isAuthenticated() && 
        (request.auth.token.role in ['super_admin', 'admin', 'team_member'] ||
         getUserData().role in ['super_admin', 'admin', 'team_member']);
    }

    function isExecutiveAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role in ['super_admin', 'admin'] ||
         getUserData().role in ['super_admin', 'admin']);
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'super_admin' ||
         getUserData().role == 'super_admin');
    }

    function getUserOrgId() {
      return request.auth.token.organizationId != null 
        ? request.auth.token.organizationId 
        : getUserData().organizationId;
    }

    function isClientOfOrg(orgId) {
      return isAuthenticated() && orgId != null && getUserOrgId() == orgId;
    }

    // Allow read and write for the active application
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
